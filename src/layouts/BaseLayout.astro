---
import '@argousiere/vespertina-design-system/core/tokens.css';
import '@argousiere/vespertina-design-system/core/styles.css';
import '../styles/app.css';
import { Navbar } from '@argousiere/vespertina-design-system/react';
import Footer from '../components/Footer';

interface Props {
  title?: string;
  description?: string;
}

const SITE_TITLE = 'The Vespertine Cadet';
const {
  title,
  description = 'Adventures in art and celestial wayfaring',
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>
  <body class="vespertina-theme vespertina-theme--dark">
    <div class="site">
      <Navbar title={SITE_TITLE} homeUrl="/" />
      <main id="main" class="app__main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
