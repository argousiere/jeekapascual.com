---
import {
  Entry,
  EntryPagination,
} from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBlogPages } from '../queries/blog-queries';

export const getStaticPaths = () => getBlogPages();

const { page } = Astro.props;
const { entry, html, previous, next } = page;
---

<BaseLayout title={entry.title} description={entry.description}>
  <div class="app-entry-page">
    <Entry entry={entry} html={html} />
    <div class="app-entry-page__pagination">
      <EntryPagination
        previousEntry={previous}
        nextEntry={next}
      />
    </div>
  </div>
</BaseLayout>
