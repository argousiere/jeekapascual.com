---
import { Entry } from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getReadingTime } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, excerpt, tags } = post.data;
---

<BaseLayout title={title} description={excerpt}>
  <Entry
    className="app__entry"
    title={title}
    date={date.toISOString().slice(0, 10)}
    excerpt={excerpt}
    readingTimeWPM={getReadingTime(post.body)}
    html={post.rendered?.html ?? ''}
    tags={tags.map((slug) => ({ slug, url: `/tag/${slug}/` }))}
  />
</BaseLayout>
