---
import { Entry } from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BLOG_IMAGE_TRANSFORM, resolveImages } from '../utils/images';
import { compiledContent, frontmatter } from '../../content/about.md';

const entry = {
  id: 'about',
  title: frontmatter.title,
  url: '/about/',
  date: '',
};
const html = resolveImages(await compiledContent(), BLOG_IMAGE_TRANSFORM);
---

<BaseLayout title={entry.title}>
  <div class="app-entry-page">
    <Entry entry={entry} html={html} />
  </div>
</BaseLayout>
