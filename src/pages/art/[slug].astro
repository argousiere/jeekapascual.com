---
import {
  Entry,
  EntryPagination,
} from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ARTWORK_IMAGE_TRANSFORM, resolveImages } from '../../utils/images';
import { getArtPosts } from '../../utils/art-utils';
import { toEntryModel } from '../../utils/post-utils';

export async function getStaticPaths() {
  const posts = await getArtPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}

const { post, newer, older } = Astro.props;

const entry = toEntryModel(post);
const { image, title } = post.data;

const artworkHtml = `<p><img src="${image.src}" alt="${title.replaceAll('"', '&quot;')}" width="${image.width}" height="${image.height}"></p>`;
const processedHtml = resolveImages(
  artworkHtml + (post.rendered?.html ?? ''),
  ARTWORK_IMAGE_TRANSFORM
);
---

<BaseLayout 
  title={entry.title} 
  description={entry.description}>
  <div class="app-entry-page">
    <Entry entry={entry} html={processedHtml} />

    <div class="app-entry-page__pagination">
      <EntryPagination
        previousEntry={older && toEntryModel(older)}
        nextEntry={newer && toEntryModel(newer)}
      />
    </div>
  </div>
</BaseLayout>
