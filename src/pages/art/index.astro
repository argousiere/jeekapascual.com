---
import { EntriesView, TagHeader } from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArtPosts } from '../../utils/art-utils';
import { toEntryModel, toTagModel } from '../../utils/post-utils';

const tagModel = toTagModel('art');
const items = (await getArtPosts()).map((post) => ({ entry: toEntryModel(post) }));
---

<BaseLayout title="Art" description={tagModel.description}>
  <div class="app-tag-page">
    <TagHeader tag={tagModel} />
    <EntriesView client:load entryListTitle="Entries" items={items} />
  </div>
</BaseLayout>
