---
import { EntryList } from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const items = posts.map(({ id, data }) => ({
  id,
  title: data.title,
  date: data.date,
  url: `/${id}/`,
}));
---

<BaseLayout>
  <section class="app__hero">
    <p class="app__tagline">Adventures in art and celestial wayfaring</p>
    <div class="ves-logo" role="img" aria-label="Vespertina logo"></div>
  </section>

  <EntryList title="Latest Posts" items={items} />
  
</BaseLayout>
