---
import { EntriesView, FeaturedList } from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseEntryModel } from '../parsers/entry-parser';
import { getPosts } from '../queries/post-queries';
import { getFeaturedItems } from '../queries/featured-queries';
import siteConfig from '../../site.config';

const posts = await getPosts();
const entries = posts.map(parseEntryModel);
const items = entries.map((entry) => ({ entry }));
const featuredItems = getFeaturedItems(entries);
---

<BaseLayout>
  <section class="app__hero">
    <div class="app__hero-intro">
      <p class="app__tagline">{siteConfig.blurb}</p>
      <div class="ves-logo" role="img" aria-label="Vespertina logo"></div>
    </div>
    {featuredItems?.length > 0 && <FeaturedList items={featuredItems} />}
  </section>

  <EntriesView client:load entryListTitle="Latest Posts" items={items} />
</BaseLayout>
