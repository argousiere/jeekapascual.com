---
import { EntriesView, TagHeader } from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTagSlugs, toEntryModel, toTagModel } from '../../utils/posts';

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPosts(), getTagSlugs()]);

  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter(({ data }) => data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const tagModel = toTagModel(tag);
const items = posts.map((post) => ({ entry: toEntryModel(post) }));
---

<BaseLayout
  title={`#${tagModel.label ?? tag}`}
  description={tagModel.description ?? `Entries tagged ${tagModel.label ?? tag}`}
>
  <div class="app-tag-page">
    <TagHeader tag={tagModel} />
    <EntriesView client:load entryListTitle="Entries" items={items} />
  </div>
</BaseLayout>
