---
import { EntriesView, TagHeader } from '@argousiere/vespertina-design-system/react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../../site.config';
import { parseTagModel } from '../../parsers/tag-parser';
import { getPosts } from '../../queries/post-queries';
import { getTag, getTagSlugs } from '../../queries/tag-queries';
import { parseEntryModel } from '../../parsers/entry-parser';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = getTagSlugs();

  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter(({ data }) => data.tags.some(({ slug }) => slug === tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const tagModel = parseTagModel(getTag(tag));
const items = posts.map((post) => ({ entry: parseEntryModel(post) }));

const route = Object.values(siteConfig.routes).find(({ url }) => url === `/tag/${tag}`);
const viewMode = route && 'viewMode' in route ? route.viewMode : siteConfig.routes.tag.viewMode;
---

<BaseLayout
  title={`#${tagModel.label ?? tag}`}
  description={tagModel.description ?? `Entries tagged ${tagModel.label ?? tag}`}
>
  <div class="app-tag-page">
    <TagHeader tag={tagModel} />
    <EntriesView
      client:load
      entryListTitle="Entries"
      items={items}
      viewMode={viewMode}
    />
  </div>
</BaseLayout>
